server {
    listen 80;
    server_name ${WORDPRESS_DOMAIN};

    root /var/www/html;
    index index.php index.html index.htm;

    client_max_body_size 64M;

    # Tambahkan header ini agar Nginx/WordPress mengenali protokol asli dari Cloudflare Tunnel
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Jika Cloudflare Tunnel Anda memaksa HTTPS di luar, beri tahu Nginx lewat header internal:
    # (Opsional jika mengalami redirect loop, pastikan Cloudflare SSL diset ke 'Full' atau 'Full (strict)')
    proxy_set_header X-Forwarded-Port 443;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        
        fastcgi_pass ${WORDPRESS_UPSTREAM_PHP}:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        
        # Meneruskan informasi HTTPS ke PHP-FPM
        fastcgi_param HTTPS on;
        
        fastcgi_read_timeout 300;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
    
    location ~* /wp-config\.php {
        deny all;
    }
}